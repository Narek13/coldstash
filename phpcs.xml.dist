<?xml version="1.0"?>
<ruleset name="Coldstash">
    <description>WooCommerce Marketplace coding standards for Coldstash (modern PSR-4 / namespaced).</description>

    <arg name="colors"/>
    <arg value="sp"/>
    <arg name="extensions" value="php"/>

    <!-- What to scan. -->
    <file>./coldstash.php</file>
    <file>./src</file>
    <file>./templates</file>
    <file>./tests</file>
    <file>./uninstall.php</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
    <exclude-pattern>*/node_modules/*</exclude-pattern>
    <exclude-pattern>*/assets/*</exclude-pattern>
    <exclude-pattern>*/build/*</exclude-pattern>
    <exclude-pattern>*/.ddev/*</exclude-pattern>

    <!--
        Base on WooCommerce-Core (woocommerce/woocommerce-sniffs): the full
        WordPress standard plus Squiz.Commenting, PHPCompatibilityWP and the
        WooCommerce sniffs. Drop only the sniffs that fight modern PSR-4 /
        namespaced OO code. All security, escaping, sanitisation and i18n
        rules stay on.
    -->
    <rule ref="WooCommerce-Core">
        <!-- PSR-4 file names (Foo.php) instead of class-foo.php. -->
        <exclude name="WordPress.Files.FileName"/>
        <!-- Allow camelCase methods/properties (PSR style). -->
        <exclude name="WordPress.NamingConventions.ValidVariableName"/>
        <exclude name="WordPress.NamingConventions.ValidFunctionName"/>
        <exclude name="Squiz.Commenting.FileComment.Missing"/>
        <!-- Allow PHPStan generic types (list<T>, array<K,V>) in @param/@return. -->
        <exclude name="Squiz.Commenting.FunctionComment.IncorrectTypeHint"/>
    </rule>

    <!-- i18n: enforce a single text domain. -->
    <rule ref="WordPress.WP.I18n">
        <properties>
            <property name="text_domain" type="array">
                <element value="coldstash"/>
            </property>
        </properties>
    </rule>

    <!-- manage_woocommerce is registered by WooCommerce, not by this plugin. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="manage_woocommerce"/>
            </property>
        </properties>
    </rule>

    <!-- Require prefixing of global symbols. -->
    <rule ref="WordPress.NamingConventions.PrefixAllGlobals">
        <properties>
            <property name="prefixes" type="array">
                <element value="coldstash"/>
                <element value="Coldstash"/>
                <element value="COLDSTASH"/>
            </property>
        </properties>
    </rule>

    <!-- Minimum supported versions for compatibility checks. -->
    <config name="minimum_wp_version" value="6.4"/>
    <config name="testVersion" value="8.1-"/>
</ruleset>
